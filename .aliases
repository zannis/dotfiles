alias vim=nvim
alias snf='kitten ssh -XC user@snf-882956.vm.okeanos.grnet.gr'
alias sl='ls'
alias hh='htop'
alias htop='btm -b --process_memory_as_value'
alias icat='kitty +kitten icat'
alias bump='brew update && brew upgrade && brew upgrade --cask --greedy'
alias bb='cd ~/dev/lens-backend/ && cargo run --bin broker'
alias ww='cd ~/dev/lens-backend/ && cargo run --bin workers'
alias ll='cd ~/dev/lens-backend/ && cargo run --bin lens-indexer'
alias cw="cargo watch -c -q -x 'clippy --workspace --all-targets -- -D warnings'"
alias εχιτ="exit"

# common-aliases (oh-my-zsh) aliases `fd` to `find . -type d -name`, which shadows
# the real fd. .aliases is sourced after oh-my-zsh, so unaliasing here wins.
unalias fd 2>/dev/null
