/*
!/.gitignore
!/.aliases
!/.claude/
!/.config/
!/.hushlogin
!/.zshrc

# karabiner writes timestamped autosaves here — config noise, not worth tracking
.config/karabiner/automatic_backups/

# The manual skill set is mostly third-party or machine-local, so it stays out.
# Skills I maintain myself are allow-listed one by one. The autonomous set the
# agent runner carries lives in onlybots-gr/onlybots (skills/).
/.claude/skills/*
!/.claude/skills/pr-review/

# secret-bearing config — auth tokens / DB credentials, never track
.config/db-envs/
.config/gh/
.config/clickhouse/
.config/github-copilot/
