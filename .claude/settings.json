{
  "env": {
    "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE": "1"
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/CLAUDE.md)",
      "Read(~/.claude/settings.json)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Skill(superpowers:*)",
      "Read(**/.env.example)",
      "Edit(**/.env.example)",
      "Bash(curl -sS -X PATCH http://127.0.0.1:3100/*)",
      "Bash(curl -sS -X PATCH http://localhost:3100/*)",
      "mcp__gitnexus__context",
      "mcp__gitnexus__impact",
      "mcp__gitnexus__trace",
      "mcp__gitnexus__list_repos"
    ],
    "deny": [
      "mcp__gitnexus__query",
      "mcp__gitnexus__cypher",
      "mcp__gitnexus__group_list",
      "mcp__gitnexus__group_sync",
      "mcp__gitnexus__rename",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/.env.staging)",
      "Edit(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(**/.env.test)",
      "Read(**/.env.prod)",
      "Edit(**/.env.prod)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Read(./secrets/**)",
      "Read(~/.config/db-envs/**)",
      "Edit(~/.config/db-envs/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "deniedMcpServers": [
    {
      "serverUrl": "https://mcp.notion.com/*"
    }
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty'); case \"$FILE\" in *.rs) ;; *) exit 0;; esac; DIR=$(dirname \"$FILE\"); while [ \"$DIR\" != \"/\" ] && [ ! -f \"$DIR/Cargo.toml\" ]; do DIR=$(dirname \"$DIR\"); done; [ -f \"$DIR/Cargo.toml\" ] && cd \"$DIR\" && cargo fmt --all -q 2>&1 || true",
            "statusMessage": "cargo fmt --all"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command'); run_fix() { TC=\"+1.91.1\"; [ -f rust-toolchain.toml ] && TC=\"\"; cargo $TC fix --allow-dirty --allow-staged; }; if echo \"$CMD\" | grep -qE '^cargo (check|clippy|test|build|c|t|b)'; then run_fix; elif echo \"$CMD\" | grep -qE '^cd .* && cargo (check|clippy|test|build|c|t|b)'; then DIR=$(echo \"$CMD\" | sed -E 's/^cd ([^ ]*) &&.*/\\1/'); if [[ \"$DIR\" = /* ]]; then cd \"$DIR\"; else cd \"$CLAUDE_PROJECT_DIR/$DIR\"; fi && run_fix; fi"
          },
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command // empty'); echo \"$CMD\" | grep -qE 'git commit($|[[:space:]])' || exit 0; DIR=\"$PWD\"; PREFIX_DIR=$(echo \"$CMD\" | sed -nE 's/^[[:space:]]*cd[[:space:]]+([^ &]+).*/\\1/p'); if [ -n \"$PREFIX_DIR\" ]; then case \"$PREFIX_DIR\" in /*) DIR=\"$PREFIX_DIR\" ;; *) DIR=\"$PWD/$PREFIX_DIR\" ;; esac; fi; while [ \"$DIR\" != \"/\" ] && [ ! -f \"$DIR/Cargo.toml\" ]; do DIR=$(dirname \"$DIR\"); done; [ -f \"$DIR/Cargo.toml\" ] || exit 0; cd \"$DIR\" || exit 0; TC=\"+1.91.1\"; [ -f rust-toolchain.toml ] && TC=\"\"; OUTPUT=$(cargo $TC clippy --workspace --all-targets --all-features -q -- -D warnings 2>&1); EXIT=$?; if [ $EXIT -ne 0 ]; then echo \"cargo clippy failed - fix warnings before committing:\" >&2; echo \"$OUTPUT\" | tail -50 >&2; exit 2; fi",
            "timeout": 300,
            "statusMessage": "cargo clippy (pre-commit gate)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.py"
  },
  "enabledPlugins": {
    "bitwarden-code-review@bitwarden-marketplace": false,
    "bitwarden-security-engineer@bitwarden-marketplace": false,
    "bitwarden-software-engineer@bitwarden-marketplace": false,
    "bitwarden-tech-lead@bitwarden-marketplace": false,
    "claude-retrospective@bitwarden-marketplace": true,
    "figma@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "linear@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "bitwarden-marketplace": {
      "source": {
        "source": "github",
        "repo": "bitwarden/ai-plugins"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
